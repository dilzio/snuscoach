ANTHROPIC_API_KEY=your-key-here
# Optional: override DB location (default: ~/.snuscoach/snuscoach.db)
# SNUSCOACH_DB=/absolute/path/to/snuscoach.db

# Optional: select active user profile by name (default: first/oldest profile in DB)
# SNUSCOACH_PROFILE=YourName

# Optional: LLM call logging.
# SNUSCOACH_LOG=true                              # default true; "false"/"0"/"off" disables
# SNUSCOACH_LOG_DIR=/absolute/path/to/logs        # default ~/.snuscoach/logs

# Optional: nudge command interaction mode (default: interactive)
# SNUSCOACH_NUDGE_MODE=interactive                # interactive (Opus, multi-turn) | report (Sonnet, numbered list)
